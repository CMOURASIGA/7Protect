# Provider escolhido pelo navegador. "fake" é o padrão seguro para desenvolvimento e homologação.
# Para uso real, defina "openai" apenas junto da chave segura abaixo no ambiente hospedado.
NEXT_PUBLIC_METIS_PROVIDER=fake
NEXT_PUBLIC_METIS_ENABLED=true

# Somente no servidor. Nunca usar NEXT_PUBLIC_ para esta chave.
OPENAI_API_KEY=
OPENAI_METIS_MODEL=gpt-4.1-mini
# Limites server-side para indisponibilidade e retry do provider real.
OPENAI_METIS_TIMEOUT_MS=12000
OPENAI_METIS_MAX_ATTEMPTS=2
